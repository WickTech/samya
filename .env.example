# ─── SĀMYA admin dashboard ────────────────────────────────────────────────
# Copy to .env.local for development. In production set these in the Vercel
# project settings (never commit real values).

# Sign-in accounts — JSON array. One entry per person.
#   role: "owner" | "dev"  (both get full access for now)
#   passwordHash: from `npm run admin:hash -- "password" email role`
# Keep it on one line in .env / Vercel:
ADMIN_USERS='[{"email":"owner@samya.example","role":"owner","passwordHash":""},{"email":"dev@example.com","role":"dev","passwordHash":""}]'

# Per-entry dev-only plaintext fallback instead of passwordHash:
#   {"email":"dev@example.com","role":"dev","password":"change-me"}

# Legacy single-owner vars — used only when ADMIN_USERS is unset:
# ADMIN_EMAIL="owner@samya.example"
# ADMIN_PASSWORD_HASH=""
# ADMIN_PASSWORD="change-me-in-dev"

# Session signing key — any random string, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ─── Persistence (Vercel KV / Upstash Redis) ──────────────────────────────
# Added automatically when you attach a KV / Upstash Redis store to the
# Vercel project. Leave blank locally to use the .data/admin-store.json file.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
